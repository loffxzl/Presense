<!-- views/partials/adminSidebar.ejs -->
<aside class="w-64 bg-white border-r border-gray-200 flex flex-col justify-between h-screen sticky top-0">
    <div>
        <!-- Logo -->
        <div class="flex items-center gap-2 px-5 py-6 border-b border-gray-100">
            <div class="w-9 h-9 rounded-lg bg-gray-900 flex items-center justify-center flex-shrink-0">
                <span class="font-serif text-white text-sm font-bold">P</span>
            </div>
            <h1 class="font-serif font-bold text-lg tracking-widest uppercase text-gray-900">Presense</h1>
        </div>

        <!-- Nav -->
        <nav class="px-3 py-5 space-y-1">
            <%
                const navItems = [
                    {
                        key: 'dashboard', href: '/admin/dashboard', label: 'Dashboard', disabled: false,
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 12l2-2m0 0l7-7 7 7M5 10v10a1 1 0 001 1h3m10-11l2 2m-2-2v10a1 1 0 01-1 1h-3m-6 0a1 1 0 001-1v-4a1 1 0 011-1h2a1 1 0 011 1v4a1 1 0 001 1m-6 0h6"/>'
                    },
                    {
                        key: 'products', href: '/admin/products', label: 'Products',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5M10 11.25h4M3.375 7.5h17.25c.621 0 1.125-.504 1.125-1.125v-1.5c0-.621-.504-1.125-1.125-1.125H3.375c-.621 0-1.125.504-1.125 1.125v1.5c0 .621.504 1.125 1.125 1.125z"/>'
                    },
                    {
                        key: 'orders', href: '/admin/orders', label: 'Orders',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 14.25l6-6m4.5-3.493V21.75l-3.75-1.5-3.75 1.5-3.75-1.5-3.75 1.5V4.757c0-1.108.806-2.057 1.907-2.185a48.507 48.507 0 0111.186 0c1.1.128 1.907 1.077 1.907 2.185zM9.75 9h.008v.008H9.75V9zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0zm4.125 4.5h.008v.008h-.008V13.5zm.375 0a.375.375 0 11-.75 0 .375.375 0 01.75 0z"/>'
                    },
                    {
                        key: 'users', href: '/admin/users', label: 'Customers',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>'
                    },
                    {
                        key: 'sales', href: '/admin/sales', label: 'Sales Report',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3 13.125C3 12.504 3.504 12 4.125 12h2.25c.621 0 1.125.504 1.125 1.125v6.75C7.5 20.496 6.996 21 6.375 21h-2.25A1.125 1.125 0 013 19.875v-6.75zM9.75 8.625c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125v11.25c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V8.625zM16.5 4.125c0-.621.504-1.125 1.125-1.125h2.25C20.496 3 21 3.504 21 4.125v15.75c0 .621-.504 1.125-1.125 1.125h-2.25a1.125 1.125 0 01-1.125-1.125V4.125z"/>'
                    },
                    {
                        key: 'coupon', href: '/admin/coupon', label: 'Coupon',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75l3 3m0 0l3-3m-3 3v-7.5M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>'
                    },
                    {
                        key: 'inventory', href: '/admin/inventory', label: 'Inventory',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M20.25 7.5l-.625 10.632a2.25 2.25 0 01-2.247 2.118H6.622a2.25 2.25 0 01-2.247-2.118L3.75 7.5m6-3V3.75A.75.75 0 0110.5 3h3a.75.75 0 01.75.75V4.5m-10.5 0h15"/>'
                    },
                    {
                        key: 'brands', href: '/admin/brands', label: 'Brands',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 11.25v8.25a1.5 1.5 0 01-1.5 1.5H5.25a1.5 1.5 0 01-1.5-1.5v-8.25M12 4.875A2.625 2.625 0 109.375 7.5H12m0-2.625V7.5m0-2.625A2.625 2.625 0 1114.625 7.5H12m0 0V21m-8.625-9.75h18c.621 0 1.125-.504 1.125-1.125v-2.25c0-.621-.504-1.125-1.125-1.125h-18c-.621 0-1.125.504-1.125 1.125v2.25c0 .621.504 1.125 1.125 1.125z"/>'
                    },
                    {
                        key: 'category', href: '/admin/category', label: 'Category',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6A2.25 2.25 0 016 3.75h2.25A2.25 2.25 0 0110.5 6v2.25a2.25 2.25 0 01-2.25 2.25H6a2.25 2.25 0 01-2.25-2.25V6zM3.75 15.75A2.25 2.25 0 016 13.5h2.25a2.25 2.25 0 012.25 2.25V18a2.25 2.25 0 01-2.25 2.25H6A2.25 2.25 0 013.75 18v-2.25zM13.5 6a2.25 2.25 0 012.25-2.25H18A2.25 2.25 0 0120.25 6v2.25A2.25 2.25 0 0118 10.5h-2.25a2.25 2.25 0 01-2.25-2.25V6zM13.5 15.75a2.25 2.25 0 012.25-2.25H18a2.25 2.25 0 012.25 2.25V18A2.25 2.25 0 0118 20.25h-2.25A2.25 2.25 0 0113.5 18v-2.25z"/>'
                    },
                    {
                        key: 'wallets', href: '/admin/wallets', label: 'Wallets',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M21 12a2.25 2.25 0 00-2.25-2.25H15a3 3 0 11-6 0H5.25A2.25 2.25 0 003 12m18 0v6a2.25 2.25 0 01-2.25 2.25H5.25A2.25 2.25 0 013 18v-6m18 0V9M3 12V9m18 0a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 9m18 0V6a2.25 2.25 0 00-2.25-2.25H5.25A2.25 2.25 0 003 6v3"/>'
                    },
                    {
                        key: 'referrals', href: '/admin/referrals', label: 'Referrals',
                        icon: '<path stroke-linecap="round" stroke-linejoin="round" d="M18 18.72a9.094 9.094 0 003.741-.479 3 3 0 00-4.682-2.72m.94 3.198l.001.031c0 .225-.012.447-.037.666A11.944 11.944 0 0112 21c-2.17 0-4.207-.576-5.963-1.584A6.062 6.062 0 016 18.719m12 0a5.971 5.971 0 00-.941-3.197m0 0A5.995 5.995 0 0012 12.75a5.995 5.995 0 00-5.058 2.772m0 0a3 3 0 00-4.681 2.72 8.986 8.986 0 003.74.477m.94-3.197a5.971 5.971 0 00-.94 3.197M15 6.75a3 3 0 11-6 0 3 3 0 016 0zm6 3a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0zm-13.5 0a2.25 2.25 0 11-4.5 0 2.25 2.25 0 014.5 0z"/>'
                    },
                ];
            %>
            <% navItems.forEach(item => { %>
                <% const isActive = activePage === item.key; %>
                <% if (item.disabled) { %>
                    <span
                        class="group relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm text-gray-350 text-gray-400 cursor-not-allowed select-none"
                        title="Coming soon"
                    >
                        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><%- item.icon %></svg>
                        <span class="flex-1"><%= item.label %></span>
                        <span class="text-[10px] font-semibold uppercase tracking-wide bg-gray-100 text-gray-400 px-1.5 py-0.5 rounded">Soon</span>
                    </span>
                <% } else { %>
                    <a
                        href="<%= item.href %>"
                        class="group relative flex items-center gap-3 px-3 py-2.5 rounded-lg text-sm font-medium transition-all duration-200 ease-out
                            <%= isActive
                                ? 'bg-gray-900 text-white shadow-sm'
                                : 'text-gray-600 hover:bg-gray-100 hover:text-gray-900 hover:translate-x-0.5' %>"
                    >
                        <% if (isActive) { %>
                            <span class="absolute left-0 top-1/2 -translate-y-1/2 h-5 w-1 rounded-r bg-yellow-500"></span>
                        <% } %>
                        <svg xmlns="http://www.w3.org/2000/svg"
                             class="w-5 h-5 flex-shrink-0 transition-transform duration-200 ease-out group-hover:scale-110 <%= isActive ? 'text-yellow-500' : 'text-gray-400 group-hover:text-gray-700' %>"
                             fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor"><%- item.icon %></svg>
                        <span><%= item.label %></span>
                    </a>
                <% } %>
            <% }); %>
        </nav>
    </div>

    <!-- Account / Logout -->
    <div class="border-t border-gray-100 p-3">
        <div class="flex items-center gap-3 px-2 py-2 mb-2">
            <div class="bg-gray-900 text-white rounded-full w-9 h-9 flex items-center justify-center font-bold text-sm flex-shrink-0">
                <%= adminName.charAt(0).toUpperCase() %>
            </div>
            <div class="min-w-0">
                <p class="font-semibold text-sm text-gray-900 truncate"><%= adminName %></p>
                <p class="text-xs text-gray-500">Administrator</p>
            </div>
        </div>
        <a
            href="/admin/logout"
            class="group flex items-center justify-center gap-2 w-full px-3 py-2.5 rounded-lg text-sm font-semibold
                   text-red-600 bg-red-50 border border-red-100
                   transition-all duration-200 ease-out
                   hover:bg-red-600 hover:text-white hover:border-red-600 hover:shadow-sm"
        >
            <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 transition-transform duration-200 group-hover:-translate-x-0.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" d="M8.25 9V5.25A2.25 2.25 0 0110.5 3h6a2.25 2.25 0 012.25 2.25v13.5A2.25 2.25 0 0116.5 21h-6a2.25 2.25 0 01-2.25-2.25V15M12 9l-3 3m0 0l3 3m-3-3H21"/>
            </svg>
            Sign Out
        </a>
    </div>
</aside>
