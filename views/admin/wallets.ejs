<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Presense Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .font-serif { font-family: Georgia, Cambria, "Times New Roman", Times, serif; }
        .modal-overlay { position:fixed; inset:0; background:rgba(0,0,0,0.5); z-index:100; display:none; align-items:center; justify-content:center; padding:16px; }
        .modal-overlay.show { display:flex; }
        .modal-box { background:#fff; border-radius:16px; padding:32px; width:100%; max-width:560px; max-height:85vh; overflow-y:auto; }
    </style>
</head>
<body class="bg-gray-50 flex min-h-screen">

    <%- include('../partials/adminSidebar', { adminName, activePage: 'wallets' }) %>

    <main class="flex-1 ml-64 p-8">
        <div class="mb-6 flex items-end justify-between flex-wrap gap-4">
            <div>
                <h2 class="text-2xl font-bold">Wallets</h2>
                <p class="text-gray-400 text-sm mt-1"><%= totalWallets %> wallet<%= totalWallets === 1 ? '' : 's' %></p>
            </div>
            <div class="bg-white border border-gray-200 rounded-xl px-5 py-3 shadow-sm">
                <p class="text-[10px] uppercase tracking-wide text-gray-400 font-semibold">Total held in wallets</p>
                <p class="font-serif text-xl font-bold text-gray-900">&#8377;<%= totalBalance %></p>
            </div>
        </div>

        <form action="/admin/wallets" method="GET" class="flex gap-3 mb-6">
            <input type="text" name="search" value="<%= search %>" placeholder="Search by customer name or email..."
                   class="border p-2 rounded-lg flex-1 text-sm focus:outline-none focus:border-gray-400"/>
            <button type="submit" class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm hover:bg-gray-700 transition">Search</button>
            <% if (search) { %>
                <a href="/admin/wallets" class="border px-4 py-2 rounded-lg text-sm text-gray-600 hover:bg-gray-100 transition">Clear</a>
            <% } %>
        </form>

        <% if (wallets.length === 0) { %>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm py-16 text-center text-gray-400 text-sm">
                No wallets yet. One is created the first time a customer receives a refund or adds money.
            </div>
        <% } else { %>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm overflow-hidden">
                <table class="w-full text-sm">
                    <thead>
                        <tr class="bg-gray-50 border-b border-gray-200 text-left text-xs uppercase tracking-wide text-gray-500">
                            <th class="px-5 py-3 font-semibold">Customer</th>
                            <th class="px-5 py-3 font-semibold">Email</th>
                            <th class="px-5 py-3 font-semibold">Balance</th>
                            <th class="px-5 py-3 font-semibold">Last activity</th>
                            <th class="px-5 py-3 font-semibold"></th>
                        </tr>
                    </thead>
                    <tbody>
                        <% wallets.forEach((w) => { %>
                            <tr class="border-b border-gray-100 last:border-0 hover:bg-gray-50 transition">
                                <td class="px-5 py-3 font-medium text-gray-900"><%= w.name %></td>
                                <td class="px-5 py-3 text-gray-500"><%= w.email %></td>
                                <td class="px-5 py-3 font-semibold text-gray-900">&#8377;<%= w.balance %></td>
                                <td class="px-5 py-3 text-gray-500">
                                    <%= new Date(w.updatedAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                </td>
                                <td class="px-5 py-3 text-right">
                                    <button type="button" data-user-id="<%= w.userId %>" data-user-name="<%= w.name %>"
                                            class="ledger-btn text-xs font-medium px-3 py-1.5 rounded-md border border-gray-200 text-gray-700 hover:bg-gray-50 transition">
                                        Transactions
                                    </button>
                                </td>
                            </tr>
                        <% }) %>
                    </tbody>
                </table>
            </div>
        <% } %>

        <% if (totalPages > 1) { %>
            <div class="flex items-center gap-2 mt-6">
                <% if (currentPage > 1) { %>
                    <a href="/admin/wallets?page=<%= currentPage - 1 %>&search=<%= search %>" class="px-3 py-1 rounded bg-gray-200 text-gray-700 text-sm hover:bg-gray-300 transition">&lt;</a>
                <% } %>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="/admin/wallets?page=<%= i %>&search=<%= search %>"
                       class="px-3 py-1 rounded text-sm transition <%= i === currentPage ? 'bg-gray-900 text-white' : 'bg-gray-200 text-gray-700 hover:bg-gray-300' %>">
                        <%= i %>
                    </a>
                <% } %>
                <% if (currentPage < totalPages) { %>
                    <a href="/admin/wallets?page=<%= currentPage + 1 %>&search=<%= search %>" class="px-3 py-1 rounded bg-gray-200 text-gray-700 text-sm hover:bg-gray-300 transition">&gt;</a>
                <% } %>
            </div>
        <% } %>
    </main>

    <!-- Transactions Modal -->
    <div id="ledgerModal" class="modal-overlay">
        <div class="modal-box">
            <div class="flex justify-between items-center mb-4">
                <h2 class="font-serif text-xl font-bold text-gray-900">Wallet transactions</h2>
                <button type="button" id="closeLedger" class="text-gray-400 hover:text-gray-600">✕</button>
            </div>
            <p class="text-sm text-gray-500 mb-4" id="ledgerUser"></p>
            <div id="ledgerBody" class="space-y-2 text-sm"></div>
        </div>
    </div>

    <script>
        const modal = document.getElementById('ledgerModal');
        const body = document.getElementById('ledgerBody');
        const reasonLabels = {
            refund_cancel: 'Refund — cancelled order',
            refund_return: 'Refund — returned order',
            order_payment: 'Paid for an order',
            order_payment_reversal: 'Payment reversed',
            topup: 'Wallet top-up'
        };

        function esc(s) {
            const d = document.createElement('div');
            d.textContent = s == null ? '' : String(s);
            return d.innerHTML;
        }

        document.querySelectorAll('.ledger-btn').forEach((btn) => {
            btn.addEventListener('click', async () => {
                document.getElementById('ledgerUser').textContent = btn.dataset.userName;
                body.innerHTML = '<p class="text-gray-400">Loading…</p>';
                modal.classList.add('show');

                try {
                    const res = await fetch(`/admin/wallets/${btn.dataset.userId}/transactions`, {
                        headers: { Accept: 'application/json' },
                        credentials: 'same-origin'
                    });
                    const data = await res.json();
                    if (!res.ok) throw new Error(data.message || 'Could not load transactions');

                    if (data.transactions.length === 0) {
                        body.innerHTML = '<p class="text-gray-400">No transactions.</p>';
                        return;
                    }

                    body.innerHTML = data.transactions.map((t) => {
                        const sign = t.type === 'credit' ? '+' : '−';
                        const color = t.type === 'credit' ? 'text-emerald-600' : 'text-gray-900';
                        const date = new Date(t.createdAt).toLocaleString('en-IN', { day: 'numeric', month: 'short', year: 'numeric', hour: '2-digit', minute: '2-digit' });
                        const order = t.orderId && t.orderId.orderCode ? ` · ${esc(t.orderId.orderCode)}` : '';
                        return `<div class="flex justify-between gap-4 border border-gray-100 rounded-lg px-4 py-3">
                            <div>
                                <p class="font-medium text-gray-900">${esc(reasonLabels[t.reason] || t.reason)}</p>
                                <p class="text-xs text-gray-400 mt-0.5">${esc(date)}${order}</p>
                            </div>
                            <div class="text-right">
                                <p class="font-semibold ${color}">${sign}₹${esc(t.amount)}</p>
                                ${t.balanceAfter != null ? `<p class="text-[10px] text-gray-400">Balance ₹${esc(t.balanceAfter)}</p>` : ''}
                            </div>
                        </div>`;
                    }).join('');
                } catch (err) {
                    body.innerHTML = `<p class="text-red-600">${esc(err.message)}</p>`;
                }
            });
        });

        document.getElementById('closeLedger').addEventListener('click', () => modal.classList.remove('show'));
        modal.addEventListener('click', (e) => { if (e.target === modal) modal.classList.remove('show'); });
    </script>
</body>
</html>
