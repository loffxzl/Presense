<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Presense Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.1/chart.umd.min.js"></script>
    <style>
        .font-serif { font-family: Georgia, Cambria, "Times New Roman", Times, serif; }
    </style>
</head>
<body class="bg-gray-50 flex min-h-screen">

    <% const inr = (n) => '₹' + Number(n || 0).toLocaleString('en-IN', { maximumFractionDigits: 0 }); %>

    <!-- Sidebar -->
    <%- include('../partials/adminSidebar', { adminName, activePage: 'dashboard' }) %>

    <!-- Main Content -->
    <main class="flex-1 ml-64 p-8 min-w-0">

        <!-- Header -->
        <div class="flex flex-wrap justify-between items-start gap-4 mb-6">
            <div>
                <h2 class="text-2xl font-bold">Dashboard</h2>
                <p class="text-gray-400 text-sm mt-1"><%= periodLabel %></p>
            </div>
            <a href="/admin/dashboard/ledger?<%= ledgerQuery %>"
               class="inline-flex items-center gap-2 bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-yellow-600 transition">
                <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 16.5v2.25A2.25 2.25 0 005.25 21h13.5A2.25 2.25 0 0021 18.75V16.5M16.5 12L12 16.5m0 0L7.5 12m4.5 4.5V3"/>
                </svg>
                Download ledger (PDF)
            </a>
        </div>

        <% if (warning) { %>
            <div class="bg-yellow-50 border border-yellow-200 text-yellow-800 px-4 py-3 rounded-lg mb-6 text-sm">
                <%= warning %> Showing the current year instead.
            </div>
        <% } %>

        <!-- Filters -->
        <div class="flex flex-wrap items-end gap-3 mb-6">
            <div class="inline-flex rounded-lg border border-gray-200 bg-white p-1">
                <% [['daily', 'Daily'], ['weekly', 'Weekly'], ['monthly', 'Monthly'], ['yearly', 'Yearly']].forEach(([key, label]) => { %>
                    <a href="/admin/dashboard?filter=<%= key %>"
                       class="px-4 py-1.5 rounded-md text-sm font-medium transition <%= filter === key ? 'bg-gray-900 text-white' : 'text-gray-600 hover:bg-gray-100' %>">
                        <%= label %>
                    </a>
                <% }) %>
            </div>

            <% if (filter === 'monthly') { %>
                <form method="GET" action="/admin/dashboard">
                    <input type="hidden" name="filter" value="monthly">
                    <select name="year" onchange="this.form.submit()"
                            class="border border-gray-200 bg-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-gray-400">
                        <% yearOptions.forEach((y) => { %>
                            <option value="<%= y %>" <%= y === year ? 'selected' : '' %>><%= y %></option>
                        <% }) %>
                    </select>
                </form>
            <% } %>

            <form method="GET" action="/admin/dashboard" class="flex items-end gap-2 ml-auto">
                <input type="hidden" name="filter" value="custom">
                <div>
                    <label class="block text-[10px] font-semibold text-gray-500 uppercase mb-1">From</label>
                    <input type="date" name="from" value="<%= filter === 'custom' ? from : '' %>" required
                           class="border border-gray-200 bg-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-gray-400">
                </div>
                <div>
                    <label class="block text-[10px] font-semibold text-gray-500 uppercase mb-1">To</label>
                    <input type="date" name="to" value="<%= filter === 'custom' ? to : '' %>" required
                           class="border border-gray-200 bg-white rounded-lg px-3 py-2 text-sm focus:outline-none focus:border-gray-400">
                </div>
                <button type="submit"
                        class="px-4 py-2 rounded-lg text-sm font-semibold border <%= filter === 'custom' ? 'bg-gray-900 text-white border-gray-900' : 'border-gray-200 text-gray-700 hover:bg-gray-100' %> transition">
                    Apply
                </button>
            </form>
        </div>

        <!-- Summary cards -->
        <div class="grid grid-cols-2 xl:grid-cols-4 gap-4 mb-6">
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Revenue</p>
                <p class="text-2xl font-bold mt-2"><%= inr(summary.revenue) %></p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Orders</p>
                <p class="text-2xl font-bold mt-2"><%= summary.orders.toLocaleString('en-IN') %></p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Units sold</p>
                <p class="text-2xl font-bold mt-2"><%= summary.units.toLocaleString('en-IN') %></p>
            </div>
            <div class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                <p class="text-xs font-semibold text-gray-500 uppercase tracking-wide">Avg. order value</p>
                <p class="text-2xl font-bold mt-2"><%= inr(summary.avgOrderValue) %></p>
            </div>
        </div>

        <!-- Chart -->
        <section class="bg-white rounded-xl border border-gray-200 shadow-sm p-6 mb-6">
            <div class="flex justify-between items-baseline mb-4">
                <h3 class="font-serif text-lg font-bold text-gray-900">Sales overview</h3>
                <% if (chart.axisNote) { %><span class="text-xs text-gray-400"><%= chart.axisNote %></span><% } %>
            </div>
            <% if (summary.orders === 0) { %>
                <p class="text-sm text-gray-400 mb-2">No sales in this period.</p>
            <% } %>
            <div style="position:relative; height:340px;">
                <canvas id="salesChart"></canvas>
            </div>
        </section>

        <!-- Top 10 boards -->
        <% const boards = [
            { title: 'Best-selling products', rows: topProducts, kind: 'product' },
            { title: 'Best-selling categories', rows: topCategories, kind: 'category' },
            { title: 'Best-selling brands', rows: topBrands, kind: 'brand' }
        ]; %>
        <div class="grid grid-cols-1 xl:grid-cols-2 2xl:grid-cols-3 gap-6">
            <% boards.forEach((board) => {
                const maxUnits = board.rows.length ? board.rows[0].unitsSold : 0;
            %>
                <section class="bg-white rounded-xl border border-gray-200 shadow-sm p-5">
                    <h3 class="font-serif text-lg font-bold text-gray-900 mb-4"><%= board.title %></h3>

                    <% if (board.rows.length === 0) { %>
                        <p class="text-sm text-gray-400 py-6 text-center">No sales in this period</p>
                    <% } else { %>
                        <ol class="space-y-3">
                            <% board.rows.forEach((row, i) => { %>
                                <li class="flex items-center gap-3">
                                    <span class="w-5 text-xs font-mono text-gray-400"><%= i + 1 %></span>

                                    <% if (board.kind === 'product') { %>
                                        <% if (row.image) { %>
                                            <img src="<%= row.image %>" alt="" class="w-10 h-10 rounded-md object-cover bg-gray-100 flex-shrink-0">
                                        <% } else { %>
                                            <div class="w-10 h-10 rounded-md bg-gray-100 flex-shrink-0"></div>
                                        <% } %>
                                    <% } %>

                                    <div class="min-w-0 flex-1">
                                        <p class="text-sm font-medium text-gray-900 truncate"><%= row.name %></p>
                                        <% if (board.kind === 'product' && row.brand) { %>
                                            <p class="text-xs text-gray-400 truncate"><%= row.brand %></p>
                                        <% } %>
                                        <div class="mt-1 h-1 rounded bg-gray-100">
                                            <div class="h-1 rounded bg-yellow-500"
                                                 style="width: <%= maxUnits ? Math.round((row.unitsSold / maxUnits) * 100) : 0 %>%"></div>
                                        </div>
                                    </div>

                                    <div class="text-right flex-shrink-0">
                                        <p class="text-sm font-semibold text-gray-900">
                                            <%= row.unitsSold %> <span class="text-xs font-normal text-gray-400">sold</span>
                                        </p>
                                        <p class="text-xs text-gray-500"><%= inr(row.revenue) %></p>
                                    </div>
                                </li>
                            <% }) %>
                        </ol>
                    <% } %>
                </section>
            <% }) %>
        </div>

        <p class="text-xs text-gray-400 mt-8 max-w-3xl">
            Counts pending, confirmed, shipped and delivered orders (COD, or online/wallet orders once paid).
            Cancelled and refunded orders and returns in progress are excluded, as are items cancelled within an order.
            Revenue is the order total as charged.
        </p>
    </main>

    <script id="chartData" type="application/json"><%- JSON.stringify(chart).replace(/</g, '\\u003c') %></script>

    <script>
        const chartData = JSON.parse(document.getElementById('chartData').textContent);
        const rupees = (n) => '₹' + Number(n).toLocaleString('en-IN');

        new Chart(document.getElementById('salesChart'), {
            type: 'bar',
            data: {
                labels: chartData.labels,
                datasets: [
                    {
                        type: 'bar',
                        label: 'Revenue',
                        data: chartData.revenue,
                        yAxisID: 'yRevenue',
                        backgroundColor: '#111827',
                        borderRadius: 4,
                        maxBarThickness: 36,
                        order: 2
                    },
                    {
                        type: 'line',
                        label: 'Orders',
                        data: chartData.orders,
                        yAxisID: 'yOrders',
                        borderColor: '#ca8a04',
                        backgroundColor: '#ca8a04',
                        tension: 0.3,
                        pointRadius: 3,
                        order: 1
                    }
                ]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                interaction: { mode: 'index', intersect: false },
                plugins: {
                    legend: { position: 'bottom' },
                    tooltip: {
                        callbacks: {
                            label: (ctx) => ctx.dataset.label === 'Revenue'
                                ? ` Revenue: ${rupees(ctx.parsed.y)}`
                                : ` Orders: ${ctx.parsed.y}`
                        }
                    }
                },
                scales: {
                    x: { grid: { display: false } },
                    yRevenue: {
                        position: 'left',
                        beginAtZero: true,
                        ticks: { callback: (v) => rupees(v) },
                        grid: { color: '#f3f4f6' }
                    },
                    yOrders: {
                        position: 'right',
                        beginAtZero: true,
                        ticks: { precision: 0 },
                        grid: { drawOnChartArea: false }
                    }
                }
            }
        });
    </script>

</body>
</html>
