<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Presense</title>

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='25' fill='%231A1A1A'/><text x='50%' y='68%' font-family='Georgia, serif' font-size='55' font-weight='bold' fill='%23D4AF37' text-anchor='middle'>P</text></svg>">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        scentCream: '#FDFBF7',
                        scentAmber: '#D4AF37',
                        scentCharcoal: '#1A1A1A',
                        scentEarth: '#705335'
                    }
                }
            }
        }
    </script>
    <style>
        @media (prefers-reduced-motion: reduce) {
            * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
        }
    </style>
</head>
<body class="bg-scentCream text-scentCharcoal font-sans antialiased">

    <div class="sticky top-0 z-50">
        <%- include('../partials/userNavbar') %>
    </div>

    <!-- Page intro strip -->
    <header class="relative bg-stone-950 px-6 py-10 overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(212,175,55,0.12)_0%,transparent_60%)] pointer-events-none"></div>
        <div class="max-w-7xl mx-auto relative z-10">
            <span class="text-xs uppercase tracking-widest text-scentAmber font-semibold block mb-2">Checkout</span>
            <h1 class="text-2xl md:text-3xl font-serif text-white tracking-wide">Your Bag</h1>
        </div>
    </header>

    <%
        const currency = (n) => '$' + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const hasBlockingIssue = items.some((i) => i.unavailable || i.quantity > i.stock);
    %>

    <div class="max-w-4xl mx-auto px-6 py-14">

        <div id="cartRoot">
            <% if (items.length === 0) { %>
                <div class="border border-stone-100 rounded-md py-24 text-center bg-white">
                    <p class="font-serif text-xl mb-2">Your bag is empty</p>
                    <p class="text-sm text-stone-500 mb-6">Whatever you're drawn to is still waiting on the shelf.</p>
                    <a href="/products"
                       class="inline-block text-xs font-semibold uppercase tracking-widest px-6 py-3 rounded-sm border border-scentCharcoal hover:bg-scentCharcoal hover:text-white transition-colors duration-300">
                        Browse fragrances
                    </a>
                </div>
            <% } else { %>
                <div class="bg-white border border-stone-100 rounded-md">
                    <div id="itemsList" class="divide-y divide-stone-100">
                        <% items.forEach((item) => { %>
                            <div class="cart-item flex items-center gap-5 p-6"
                                 data-product-id="<%= item.productId %>" data-variant-id="<%= item.variantId %>" data-stock="<%= item.stock %>">

                                <% if (item.image) { %>
                                    <img src="<%= item.image %>" alt="<%= item.name %>"
                                         class="w-20 h-20 object-cover rounded-md border border-stone-100 shrink-0">
                                <% } else { %>
                                    <div class="w-20 h-20 rounded-md bg-stone-50 border border-stone-100 flex items-center justify-center text-[10px] text-stone-400 uppercase tracking-wide shrink-0">
                                        No image
                                    </div>
                                <% } %>

                                <div class="flex-1 min-w-0">
                                    <span class="text-xs text-stone-400 uppercase tracking-wider"><%= item.brand %></span>
                                    <h3 class="font-serif text-lg truncate"><%= item.name %></h3>
                                    <p class="text-xs text-stone-500 mt-0.5"><%= item.size %></p>
                                    <% if (item.unavailable) { %>
                                        <p class="text-xs text-scentEarth font-medium mt-1">This size is no longer available</p>
                                    <% } else if (item.quantity > item.stock) { %>
                                        <p class="text-xs text-scentEarth font-medium mt-1">Only <%= item.stock %> left in stock</p>
                                    <% } %>
                                </div>

                                <div class="qty-control flex items-center border border-stone-200 rounded-sm shrink-0">
                                    <button type="button" class="qty-minus w-8 h-8 text-sm text-scentCharcoal hover:bg-stone-50 transition-colors duration-200 disabled:opacity-30 disabled:cursor-not-allowed"
                                            aria-label="Decrease quantity" <%= item.quantity <= 1 ? 'disabled' : '' %>>–</button>
                                    <span class="qty-value w-8 text-center text-sm font-mono"><%= item.quantity %></span>
                                    <button type="button" class="qty-plus w-8 h-8 text-sm text-scentCharcoal hover:bg-stone-50 transition-colors duration-200 disabled:opacity-30 disabled:cursor-not-allowed"
                                            aria-label="Increase quantity" <%= (item.unavailable || item.quantity >= item.stock) ? 'disabled' : '' %>>+</button>
                                </div>

                                <div class="flex flex-col items-end gap-2 shrink-0">
                                    <span class="text-sm font-semibold"><%= currency(item.lineTotal) %></span>
                                    <button type="button" class="remove-btn text-[11px] uppercase tracking-widest text-stone-400 hover:text-scentEarth transition-colors duration-300 border-b border-stone-200 hover:border-scentEarth">
                                        Remove
                                    </button>
                                </div>
                            </div>
                        <% }) %>
                    </div>
                </div>

                <div class="flex justify-between items-baseline mt-8 pt-6 border-t border-stone-200">
                    <span class="text-xs uppercase tracking-widest text-stone-400 font-semibold">Subtotal</span>
                    <span class="font-serif text-3xl" id="subtotalAmount"><%= currency(subtotal) %></span>
                </div>

                <% if (hasBlockingIssue) { %>
                    <p class="text-xs text-scentEarth text-right mt-2">Resolve unavailable or out-of-stock items before checking out.</p>
                <% } %>

                <button type="button" id="checkoutBtn"
                        class="w-full mt-6 py-3.5 rounded-sm text-sm font-semibold uppercase tracking-widest bg-scentCharcoal text-white hover:bg-scentAmber hover:text-scentCharcoal transition-colors duration-300 disabled:opacity-40 disabled:cursor-not-allowed disabled:hover:bg-scentCharcoal disabled:hover:text-white"
                        <%= hasBlockingIssue ? 'disabled' : '' %>>
                    Proceed to checkout
                </button>
            <% } %>
        </div>
    </div>

    <!-- Footer -->
    <footer class="bg-scentCharcoal text-stone-400 py-12 px-6 text-center text-sm">
        <p>&copy; 2026 Presense E-Commerce. Built with Node.js, Express, & MongoDB.</p>
    </footer>

    <script>
        const itemsList = document.getElementById('itemsList');

        async function callCartApi(url, method, body) {
            const response = await fetch(url, {
                method,
                headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                credentials: 'same-origin',
                body: body ? JSON.stringify(body) : undefined
            });
            const result = await response.json();
            if (!response.ok) throw new Error(result.message || 'Something went wrong');
            return result;
        }

        function renderAfterUpdate(data) {
            // Simplest reliable approach: reload so quantities/stock warnings/subtotal
            // all stay perfectly in sync with the server.
            window.location.reload();
        }

        if (itemsList) {
            itemsList.addEventListener('click', async (e) => {
                if (e.target.disabled) return; // respect the disabled state rendered server-side

                const row = e.target.closest('.cart-item');
                if (!row) return;
                const productId = row.dataset.productId;
                const variantId = row.dataset.variantId;
                const stock = Number(row.dataset.stock);
                const qtyEl = row.querySelector('.qty-value');
                const currentQty = Number(qtyEl.textContent);

                try {
                    if (e.target.classList.contains('qty-plus')) {
                        if (currentQty + 1 > stock) return alert('No more stock available for this size.');
                        const data = await callCartApi(`/cart/${productId}/${variantId}`, 'PATCH', { quantity: currentQty + 1 });
                        renderAfterUpdate(data);
                    }
                    if (e.target.classList.contains('qty-minus')) {
                        if (currentQty <= 1) return; // use Remove to drop to zero
                        const data = await callCartApi(`/cart/${productId}/${variantId}`, 'PATCH', { quantity: currentQty - 1 });
                        renderAfterUpdate(data);
                    }
                    if (e.target.classList.contains('remove-btn')) {
                        const data = await callCartApi(`/cart/${productId}/${variantId}`, 'DELETE');
                        renderAfterUpdate(data);
                    }
                } catch (err) {
                    alert(err.message);
                }
            });
        }

        const checkoutBtn = document.getElementById('checkoutBtn');
        if (checkoutBtn) {
            checkoutBtn.addEventListener('click', () => {
                if (checkoutBtn.disabled) return;
                window.location.href = '/checkout';
            });
        }
    </script>

</body>
</html>
