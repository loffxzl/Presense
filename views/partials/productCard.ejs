<%# views/partials/productCard.ejs  — expects: p (card from homeService) %>
<%
  const money = (n) => '₹' + Number(n).toLocaleString('en-IN', { maximumFractionDigits: 2 });
  const onSale = p.mrp > p.price;
%>
<a href="/products/<%= p.slug %>" class="group flex flex-col transform transition-all duration-300 hover:-translate-y-1">
    <div class="bg-stone-50 rounded-md p-6 h-72 flex items-center justify-center relative overflow-hidden mb-4 border border-stone-100 transition-all duration-300 group-hover:bg-stone-100/50 group-hover:shadow-md">
        <span class="absolute top-3 left-3 bg-stone-900 text-white text-[10px] uppercase font-semibold px-2 py-0.5 tracking-wider rounded z-10 shadow-sm"><%= p.category %></span>

        <% if (!p.inStock) { %>
            <span class="absolute top-3 right-3 bg-white text-stone-500 border border-stone-200 text-[10px] uppercase font-semibold px-2 py-0.5 tracking-wider rounded z-10">Sold out</span>
        <% } else if (p.offerPercent > 0) { %>
            <span class="absolute top-3 right-3 bg-scentAmber text-scentCharcoal text-[10px] uppercase font-bold px-2 py-0.5 tracking-wider rounded z-10 shadow-sm"><%= p.offerPercent %>% off</span>
        <% } %>

        <% if (p.image) { %>
            <img src="<%= p.image %>" alt="<%= p.name %>" loading="lazy"
                 class="max-h-52 object-contain transform transition-transform duration-700 ease-out group-hover:scale-105 <%= p.inStock ? '' : 'opacity-50' %>">
        <% } else { %>
            <span class="text-xs text-stone-400">No image</span>
        <% } %>
    </div>

    <% if (p.brand) { %><span class="text-xs text-stone-400 uppercase tracking-wider mb-1"><%= p.brand %></span><% } %>
    <h3 class="font-medium text-stone-800 group-hover:text-scentAmber transition-colors duration-300 mb-1"><%= p.name %></h3>

    <p class="text-sm mb-3 flex items-baseline gap-2">
        <span class="font-semibold text-stone-900"><%= p.hasMultipleSizes ? 'From ' : '' %><%= money(p.price) %></span>
        <% if (onSale) { %><span class="text-xs text-stone-400 line-through"><%= money(p.mrp) %></span><% } %>
    </p>

    <span class="mt-auto text-center border border-scentCharcoal text-xs font-semibold py-2.5 rounded group-hover:bg-scentCharcoal group-hover:text-white transition-all duration-300">View Details</span>
</a>
