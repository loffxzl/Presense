<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Presense Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>.font-serif { font-family: Georgia, Cambria, "Times New Roman", Times, serif; }</style>
</head>
<body class="bg-gray-50 flex min-h-screen">

    <%- include('../partials/adminSidebar', { adminName, activePage: 'category-offers' }) %>

    <%
        const stateStyle = {
            active:  'bg-green-50 text-green-700 border-green-200',
            paused:  'bg-yellow-50 text-yellow-700 border-yellow-200',
            expired: 'bg-red-50 text-red-600 border-red-200',
            none:    'bg-gray-50 text-gray-400 border-gray-200'
        };
        const stateLabel = { active: 'Active', paused: 'Paused', expired: 'Expired', none: 'No offer' };
        const tabs = [
            { key: '', label: 'All', count: counts.all },
            { key: 'active', label: 'Active', count: counts.active },
            { key: 'paused', label: 'Paused', count: counts.paused },
            { key: 'expired', label: 'Expired', count: counts.expired },
            { key: 'none', label: 'No offer', count: counts.none }
        ];
        const qs = (over) => {
            const p = new URLSearchParams();
            const s = Object.assign({ status, search, page: currentPage }, over);
            Object.keys(s).forEach((k) => { if (s[k]) p.set(k, s[k]); });
            const out = p.toString();
            return '/admin/category-offers' + (out ? '?' + out : '');
        };
        const fmtDate = (d) => new Date(d).toLocaleDateString('en-IN', { day: '2-digit', month: 'short', year: 'numeric', timeZone: 'Asia/Kolkata' });
    %>

    <main class="flex-1 ml-64 p-8">
        <div class="mb-6 flex items-end justify-between flex-wrap gap-4">
            <div>
                <h2 class="text-2xl font-bold">Category Offers</h2>
                <p class="text-gray-400 text-sm mt-1">
                    A discount on every product in a category. Customers always get the higher of this and a product's own offer.
                </p>
            </div>
            <form method="GET" action="/admin/category-offers" class="flex gap-2">
                <% if (status) { %><input type="hidden" name="status" value="<%= status %>"><% } %>
                <input type="text" name="search" value="<%= search %>" placeholder="Search category..."
                       class="px-3 py-2 border border-gray-200 rounded-lg bg-white text-sm w-56">
                <button class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-yellow-600 transition">Search</button>
            </form>
        </div>

        <% if (saved) { %><div class="mb-4 bg-green-50 border border-green-200 text-green-700 text-sm px-4 py-3 rounded-lg"><%= saved %></div><% } %>
        <% if (error) { %><div class="mb-4 bg-red-50 border border-red-200 text-red-600 text-sm px-4 py-3 rounded-lg"><%= error %></div><% } %>

        <!-- Status tabs -->
        <div class="flex flex-wrap gap-2 mb-4">
            <% tabs.forEach((t) => { %>
                <a href="<%= qs({ status: t.key, page: '' }) %>"
                   class="px-3 py-1.5 rounded-full text-xs font-semibold border transition <%= status === t.key ? 'bg-gray-900 text-white border-gray-900' : 'bg-white text-gray-500 border-gray-200 hover:border-gray-400' %>">
                    <%= t.label %> <span class="opacity-60"><%= t.count %></span>
                </a>
            <% }) %>
        </div>

        <div class="bg-white border border-gray-200 rounded-2xl shadow-sm overflow-hidden">
            <table class="w-full text-sm">
                <thead class="bg-gray-50 text-[11px] uppercase tracking-wide text-gray-400">
                    <tr>
                        <th class="text-left font-semibold px-5 py-3">Category</th>
                        <th class="text-left font-semibold px-5 py-3">Discount</th>
                        <th class="text-left font-semibold px-5 py-3">Ends</th>
                        <th class="text-left font-semibold px-5 py-3">Status</th>
                        <th class="text-right font-semibold px-5 py-3">Actions</th>
                    </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                    <% if (items.length === 0) { %>
                        <tr><td colspan="5" class="px-5 py-12 text-center text-gray-400">No categories match.</td></tr>
                    <% } %>
                    <% items.forEach((c) => { %>
                        <tr>
                            <td class="px-5 py-4">
                                <div class="flex items-center gap-3">
                                    <% if (c.imageUrl) { %>
                                        <img src="<%= c.imageUrl %>" alt="" class="w-9 h-9 rounded-lg object-cover border border-gray-100">
                                    <% } else { %>
                                        <div class="w-9 h-9 rounded-lg bg-gray-100"></div>
                                    <% } %>
                                    <div>
                                        <p class="font-semibold text-gray-900"><%= c.name %></p>
                                        <% if (c.categoryHidden) { %>
                                            <p class="text-[11px] text-red-500">Category is hidden, so its offer is not applied</p>
                                        <% } %>
                                    </div>
                                </div>
                            </td>
                            <td class="px-5 py-4">
                                <% if (c.percent) { %>
                                    <span class="font-semibold"><%= c.percent %>% off</span>
                                    <% if (c.label) { %><p class="text-[11px] text-gray-400"><%= c.label %></p><% } %>
                                <% } else { %>
                                    <span class="text-gray-300">&mdash;</span>
                                <% } %>
                            </td>
                            <td class="px-5 py-4 text-gray-500">
                                <%= c.expiryDate ? fmtDate(c.expiryDate) : '—' %>
                            </td>
                            <td class="px-5 py-4">
                                <span class="inline-block px-2.5 py-1 rounded-full text-[11px] font-semibold border <%= stateStyle[c.state] %>"><%= stateLabel[c.state] %></span>
                            </td>
                            <td class="px-5 py-4">
                                <div class="flex items-center justify-end gap-2">
                                    <button type="button"
                                            class="offer-edit px-3 py-1.5 rounded-lg text-xs font-semibold border border-gray-200 hover:border-gray-900 transition"
                                            data-id="<%= c._id %>"
                                            data-name="<%= c.name %>"
                                            data-percent="<%= c.percent || '' %>"
                                            data-label="<%= c.label %>"
                                            data-expiry="<%= c.expiryInput %>"
                                            data-active="<%= c.state === 'none' ? 'true' : String(c.isActive) %>"
                                            data-has-offer="<%= c.state === 'none' ? 'false' : 'true' %>">
                                        <%= c.state === 'none' ? 'Set offer' : 'Edit' %>
                                    </button>

                                    <% if (c.state === 'active' || c.state === 'paused') { %>
                                        <form method="POST" action="/admin/category-offers/<%= c._id %>/toggle">
                                            <input type="hidden" name="_status" value="<%= status %>">
                                            <input type="hidden" name="_search" value="<%= search %>">
                                            <input type="hidden" name="_page" value="<%= currentPage %>">
                                            <button class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-gray-200 hover:border-gray-900 transition">
                                                <%= c.state === 'active' ? 'Pause' : 'Resume' %>
                                            </button>
                                        </form>
                                    <% } %>

                                    <% if (c.state !== 'none') { %>
                                        <form method="POST" action="/admin/category-offers/<%= c._id %>/remove"
                                              onsubmit="return confirm('Remove the offer from this category?');">
                                            <input type="hidden" name="_status" value="<%= status %>">
                                            <input type="hidden" name="_search" value="<%= search %>">
                                            <input type="hidden" name="_page" value="<%= currentPage %>">
                                            <button class="px-3 py-1.5 rounded-lg text-xs font-semibold border border-red-200 text-red-600 hover:bg-red-50 transition">Remove</button>
                                        </form>
                                    <% } %>
                                </div>
                            </td>
                        </tr>
                    <% }) %>
                </tbody>
            </table>
        </div>

        <% if (totalPages > 1) { %>
            <div class="flex items-center justify-center gap-2 mt-6">
                <% if (currentPage > 1) { %>
                    <a href="<%= qs({ page: currentPage - 1 }) %>" class="px-3 py-1.5 rounded-lg text-sm border border-gray-200 bg-white hover:border-gray-900">Prev</a>
                <% } %>
                <span class="text-sm text-gray-500">Page <%= currentPage %> of <%= totalPages %></span>
                <% if (currentPage < totalPages) { %>
                    <a href="<%= qs({ page: currentPage + 1 }) %>" class="px-3 py-1.5 rounded-lg text-sm border border-gray-200 bg-white hover:border-gray-900">Next</a>
                <% } %>
            </div>
        <% } %>
    </main>

    <!-- Offer modal -->
    <div id="offerModal" class="hidden fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4">
        <form id="offerForm" method="POST" class="bg-white rounded-2xl shadow-xl w-full max-w-md p-6" novalidate>
            <input type="hidden" name="_status" value="<%= status %>">
            <input type="hidden" name="_search" value="<%= search %>">
            <input type="hidden" name="_page" value="<%= currentPage %>">

            <h3 class="font-semibold text-lg" id="offerTitle">Set offer</h3>
            <p class="text-xs text-gray-400 mb-4" id="offerCategory"></p>

            <div class="grid grid-cols-2 gap-4">
                <div>
                    <label for="offerPercent" class="block text-xs font-semibold text-gray-500 uppercase mb-1">Discount (%)</label>
                    <input type="number" id="offerPercent" name="offerPercent" min="1" max="<%= maxPercent %>" step="1"
                           class="w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50" placeholder="e.g. 15">
                </div>
                <div>
                    <label for="offerExpiry" class="block text-xs font-semibold text-gray-500 uppercase mb-1">Ends on</label>
                    <input type="date" id="offerExpiry" name="offerExpiry" min="<%= todayIST %>"
                           class="w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50">
                </div>
            </div>

            <div class="mt-4">
                <label for="offerLabel" class="block text-xs font-semibold text-gray-500 uppercase mb-1">Badge text <span class="font-normal normal-case text-gray-400">(optional)</span></label>
                <input type="text" id="offerLabel" name="offerLabel" maxlength="40"
                       class="w-full px-3 py-2 border border-gray-200 rounded-lg bg-gray-50" placeholder="e.g. Winter Sale">
            </div>

            <label class="flex items-center gap-2 text-sm mt-4 cursor-pointer">
                <input type="checkbox" id="offerActive" name="offerActive" class="w-4 h-4 accent-yellow-600">
                Offer is active
            </label>

            <p id="offerError" class="hidden text-red-500 text-xs mt-3"></p>

            <div class="flex justify-end gap-2 mt-6">
                <button type="button" id="offerCancel" class="px-4 py-2 rounded-lg text-sm font-semibold border border-gray-200 hover:border-gray-900 transition">Cancel</button>
                <button type="submit" class="bg-gray-900 text-white px-5 py-2 rounded-lg text-sm font-semibold hover:bg-yellow-600 transition">Save offer</button>
            </div>
        </form>
    </div>

    <script>
        (function () {
            const modal = document.getElementById('offerModal');
            const form = document.getElementById('offerForm');
            const errEl = document.getElementById('offerError');
            const MAX = <%= maxPercent %>;
            const f = {
                percent: document.getElementById('offerPercent'),
                expiry: document.getElementById('offerExpiry'),
                label: document.getElementById('offerLabel'),
                active: document.getElementById('offerActive')
            };

            const close = () => { modal.classList.add('hidden'); errEl.classList.add('hidden'); };
            const fail = (msg) => { errEl.textContent = msg; errEl.classList.remove('hidden'); return false; };

            document.querySelectorAll('.offer-edit').forEach((btn) => {
                btn.addEventListener('click', () => {
                    const d = btn.dataset;
                    form.action = '/admin/category-offers/' + d.id;
                    document.getElementById('offerTitle').textContent = d.hasOffer === 'true' ? 'Edit offer' : 'Set offer';
                    document.getElementById('offerCategory').textContent = d.name;
                    f.percent.value = d.percent;
                    f.expiry.value = d.expiry;
                    f.label.value = d.label;
                    f.active.checked = d.active === 'true';
                    errEl.classList.add('hidden');
                    modal.classList.remove('hidden');
                    f.percent.focus();
                });
            });

            document.getElementById('offerCancel').addEventListener('click', close);
            modal.addEventListener('click', (e) => { if (e.target === modal) close(); });
            document.addEventListener('keydown', (e) => { if (e.key === 'Escape') close(); });

            form.addEventListener('submit', (e) => {
                const percent = Number(f.percent.value);
                if (!f.percent.value.trim() || !Number.isFinite(percent) || percent < 1 || percent > MAX) {
                    e.preventDefault(); return fail('Discount must be between 1% and ' + MAX + '%');
                }
                if (!f.expiry.value) { e.preventDefault(); return fail('Please choose when the offer ends'); }
                if (f.active.checked && new Date(f.expiry.value + 'T23:59:59+05:30') <= new Date()) {
                    e.preventDefault(); return fail('End date must be in the future');
                }
            });
        })();
    </script>
</body>
</html>
