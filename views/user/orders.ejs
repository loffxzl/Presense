<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Presense</title>

    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='25' fill='%23171717'/><text x='50%' y='68%' font-family='Georgia, serif' font-size='55' font-weight='bold' fill='%23C9A227' text-anchor='middle'>P</text></svg>">

    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        scentCream: '#F8F6F1',
                        scentAmber: '#C9A227',
                        scentCharcoal: '#171717',
                        scentEarth: '#705335'
                    },
                    fontFamily: {
                        serif: ['Georgia', 'serif'],
                        sans: ['Inter', 'system-ui', 'sans-serif']
                    }
                }
            }
        }
    </script>

    <style>
        * { box-sizing: border-box; }
        body { background: #F8F6F1; }
        ::selection { background: #C9A227; color: #171717; }

        .modal-overlay { position:fixed; inset:0; background:rgba(23,23,23,0.55); z-index:100; display:none; align-items:center; justify-content:center; padding:16px; }
        .modal-overlay.show { display:flex; }
    </style>
</head>
<body class="text-scentCharcoal font-sans antialiased">

    <div class="sticky top-0 z-50">
        <%- include('../partials/userNavbar') %>
    </div>

    <!-- HERO -->
    <header class="relative overflow-hidden bg-scentCharcoal">
        <div class="absolute -top-40 -left-40 h-[500px] w-[500px] rounded-full bg-scentAmber/10 blur-3xl pointer-events-none"></div>
        <div class="absolute -bottom-48 right-0 h-[550px] w-[550px] rounded-full bg-white/5 blur-3xl pointer-events-none"></div>

        <div class="relative max-w-[1100px] mx-auto px-5 sm:px-8 lg:px-12 py-12 lg:py-16">
            <div class="flex items-center gap-3 mb-5">
                <span class="w-[34px] h-px bg-scentAmber"></span>
                <span class="text-[10px] sm:text-xs uppercase tracking-[0.28em] text-scentAmber font-semibold">
                    Your Account
                </span>
            </div>
            <h1 class="font-serif text-4xl sm:text-5xl text-white leading-[1.05] tracking-tight">Your orders</h1>
            <p class="mt-4 max-w-xl text-sm sm:text-base leading-relaxed text-stone-400">
                Track, manage and revisit everything you've ordered from Presense.
            </p>
        </div>
    </header>

    <main class="max-w-[1100px] mx-auto px-5 sm:px-8 lg:px-12 py-10 lg:py-14">

        <form action="/orders" method="GET" class="flex gap-3 mb-8">
            <input type="text" name="search" value="<%= search %>" placeholder="Search by order ID or product name…"
                   class="flex-1 px-4 py-3 bg-white border border-stone-200 rounded-lg text-sm focus:outline-none focus:border-scentAmber focus:ring-1 focus:ring-scentAmber transition">
            <button type="submit"
                    class="px-6 py-3 rounded-lg bg-scentCharcoal text-white text-[10px] font-semibold uppercase tracking-[0.2em] hover:bg-scentAmber hover:text-scentCharcoal transition-all duration-300">
                Search
            </button>
        </form>

        <% if (orders.length === 0) { %>
            <div class="bg-white border border-stone-200 rounded-xl min-h-[380px] flex items-center justify-center text-center px-6">
                <div class="max-w-md">
                    <div class="mx-auto w-16 h-16 rounded-full bg-stone-100 flex items-center justify-center mb-6">
                        <span class="font-serif text-xl text-stone-400">P</span>
                    </div>
                    <p class="text-[10px] uppercase tracking-[0.25em] text-scentAmber font-semibold mb-3">No Orders</p>
                    <h2 class="font-serif text-3xl text-stone-900 mb-3">Nothing here yet</h2>
                    <p class="text-sm text-stone-500 leading-relaxed mb-7">
                        Once you place an order, you'll be able to track it and manage it here.
                    </p>
                    <a href="/products"
                       class="inline-flex items-center justify-center px-6 py-3 bg-scentCharcoal text-white rounded-lg text-[10px] uppercase tracking-[0.18em] font-semibold hover:bg-scentAmber hover:text-scentCharcoal transition">
                        Browse Fragrances
                    </a>
                </div>
            </div>
        <% } else { %>
            <div class="space-y-4">
                <% orders.forEach((order) => {
                    const isFinal = ['delivered', 'refunded'].includes(order.status);
                    const isProblem = ['cancelled', 'return_rejected'].includes(order.status);
                    const isReturnFlow = order.status.startsWith('return') && !isProblem;
                    const statusClasses = isFinal
                        ? 'border-emerald-600 text-emerald-700 bg-emerald-50'
                        : isProblem
                            ? 'border-red-400 text-red-600 bg-red-50'
                            : isReturnFlow
                                ? 'border-scentAmber text-scentEarth bg-amber-50'
                                : 'border-stone-300 text-stone-600 bg-stone-50';
                %>
                    <a href="/orders/<%= order._id %>"
                       class="block bg-white border border-stone-200 rounded-xl p-5 sm:p-6 hover:border-scentAmber hover:shadow-[0_12px_35px_rgba(23,23,23,0.06)] transition-all duration-300">
                        <div class="flex items-start justify-between gap-4 flex-wrap">
                            <div>
                                <p class="font-serif text-lg text-stone-900">Order <%= order.orderCode %></p>
                                <p class="text-xs text-stone-400 mt-1">
                                    <%= new Date(order.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                    &middot; <%= order.items.length %> item<%= order.items.length === 1 ? '' : 's' %>
                                </p>
                            </div>
                            <span class="inline-flex items-center px-3 py-1.5 rounded-full border text-[10px] uppercase tracking-[0.12em] font-semibold <%= statusClasses %>">
                                <%= order.status.replace('_', ' ') %>
                            </span>
                        </div>
                        <div class="flex items-end justify-between mt-4 pt-4 border-t border-stone-100">
                            <span class="text-base font-semibold text-stone-900">₹<%= order.pricing.total.toLocaleString('en-IN') %></span>
                            <span class="flex items-center gap-2 text-[9px] uppercase tracking-[0.2em] font-semibold text-stone-400">
                                View order <span>→</span>
                            </span>
                        </div>
                    </a>
                <% }) %>
            </div>
        <% } %>

        <% if (totalPages > 1) { %>
            <nav aria-label="Pagination" class="flex items-center justify-center gap-2 mt-12 pt-8 border-t border-stone-200">
                <% if (currentPage > 1) { %>
                    <a href="/orders?page=<%= currentPage - 1 %>&search=<%= search %>" aria-label="Previous page"
                       class="w-10 h-10 flex items-center justify-center rounded-lg border border-stone-200 bg-white text-sm text-stone-600 hover:border-scentAmber hover:text-scentAmber transition">←</a>
                <% } %>
                <% for (let i = 1; i <= totalPages; i++) { %>
                    <a href="/orders?page=<%= i %>&search=<%= search %>"
                       class="w-10 h-10 flex items-center justify-center rounded-lg text-sm transition <%= i === currentPage ? 'bg-scentCharcoal text-white shadow-sm' : 'bg-white border border-stone-200 text-stone-600 hover:border-scentAmber hover:text-scentAmber' %>">
                        <%= i %>
                    </a>
                <% } %>
                <% if (currentPage < totalPages) { %>
                    <a href="/orders?page=<%= currentPage + 1 %>&search=<%= search %>" aria-label="Next page"
                       class="w-10 h-10 flex items-center justify-center rounded-lg border border-stone-200 bg-white text-sm text-stone-600 hover:border-scentAmber hover:text-scentAmber transition">→</a>
                <% } %>
            </nav>
        <% } %>
    </main>

    <footer class="bg-scentCharcoal text-stone-400 mt-12">
        <div class="max-w-[1540px] mx-auto px-5 sm:px-8 lg:px-12 py-12">
            <div class="flex flex-col md:flex-row items-center justify-between gap-5">
                <div class="text-center md:text-left">
                    <p class="font-serif text-lg text-white mb-1">Presense</p>
                    <p class="text-xs text-stone-500">Curated fragrances. Lasting presence.</p>
                </div>
                <p class="text-xs text-stone-500">&copy; 2026 Presense E-Commerce. Built with Node.js, Express & MongoDB.</p>
            </div>
        </div>
    </footer>

</body>
</html>
