<!-- views/partials/userNavbar.ejs
     Expects (all optional, default to safe values if omitted):
       - search      (string)  current search term
       - categoryId  (string)  current category filter, for preserving state through search
       - sortby      (string)  current sort, for preserving state through search
       - minPrice    (number/string) current min price filter
       - maxPrice    (number/string) current max price filter
-->
<nav class="border-b border-stone-200 bg-white/80 backdrop-blur-md sticky top-0 z-50 px-6 py-4">
    <div class="max-w-7xl mx-auto flex justify-between items-center">

        <a href="/" class="text-2xl font-serif tracking-widest uppercase font-bold text-scentCharcoal hover:text-scentEarth transition-colors duration-500">
            Presense
        </a>

        <div class="hidden md:flex items-center space-x-8">
            <a href="/" class="text-sm font-medium text-scentCharcoal hover:text-scentAmber transition-colors duration-300">Home</a>
            <a href="/products" class="text-sm font-medium text-scentCharcoal hover:text-scentAmber transition-colors duration-300">Products</a>
            <a href="/about" class="text-sm font-medium text-scentCharcoal hover:text-scentAmber transition-colors duration-300">About</a>
            <a href="/auth/logout" class="text-sm font-medium text-scentCharcoal hover:text-scentAmber transition-colors duration-300">Logout</a>
        </div>

        <div class="flex items-center space-x-5">
            <button id="searchToggle" aria-label="Search" aria-expanded="false" aria-controls="searchBar"
                    class="text-scentCharcoal hover:text-scentAmber transition-colors duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path></svg>
            </button>

            <a href="/wishlist" aria-label="Wishlist" class="text-scentCharcoal hover:text-scentAmber transition-colors duration-300">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path></svg>
            </a>

            <a href="/cart" aria-label="Cart" class="text-scentCharcoal hover:text-scentAmber transition-colors duration-300 relative">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"></path></svg>
            </a>

            <div class="w-px h-6 bg-stone-300 hidden sm:block mx-1"></div>

            <a href="/profile" aria-label="My Account" class="flex items-center space-x-2 group pl-1">
                <div class="w-8 h-8 rounded-full bg-scentCharcoal flex items-center justify-center text-scentAmber font-serif font-bold text-xs shadow-sm group-hover:bg-scentAmber group-hover:text-white transition-colors duration-300">
                    AE
                </div>
            </a>
        </div>
    </div>

    <!-- Search bar (toggled by the search icon; works at every screen size) -->
    <div id="searchBar" class="hidden pt-4">
        <form action="/products" method="GET" class="max-w-7xl mx-auto flex gap-2">
            <input type="hidden" name="categoryId" value="<%= typeof categoryId !== 'undefined' ? categoryId : '' %>">
            <input type="hidden" name="sortby" value="<%= typeof sortby !== 'undefined' ? sortby : 'newest' %>">
            <input type="hidden" name="minPrice" value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>">
            <input type="hidden" name="maxPrice" value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>">
            <label for="searchInput" class="sr-only">Search fragrances</label>
            <div class="relative flex-1">
                <input id="searchInput" type="text" name="search" value="<%= typeof search !== 'undefined' ? search : '' %>"
                       placeholder="Search fragrances..."
                       class="w-full px-4 py-2.5 pr-9 rounded-sm text-sm border border-stone-200 focus:outline-none focus:border-scentAmber">
                <% if (typeof search !== 'undefined' && search) { %>
                    <a href="/products?categoryId=<%= encodeURIComponent(typeof categoryId !== 'undefined' ? categoryId : '') %>&sortby=<%= encodeURIComponent(typeof sortby !== 'undefined' ? sortby : 'newest') %>&minPrice=<%= typeof minPrice !== 'undefined' ? minPrice : '' %>&maxPrice=<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>"
                       aria-label="Clear search"
                       class="absolute right-2.5 top-1/2 -translate-y-1/2 text-stone-400 hover:text-scentCharcoal transition-colors duration-300">
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                    </a>
                <% } %>
            </div>
            <button type="submit"
                    class="px-5 py-2.5 rounded-sm text-xs font-semibold uppercase tracking-widest bg-scentCharcoal text-white hover:bg-scentAmber hover:text-scentCharcoal transition-colors duration-300 shrink-0">
                Search
            </button>
        </form>
    </div>
</nav>

<script>
    (function() {
        const searchToggle = document.getElementById('searchToggle');
        const searchBar = document.getElementById('searchBar');
        if (!searchToggle || !searchBar) return;

        searchToggle.addEventListener('click', () => {
            const isHidden = searchBar.classList.contains('hidden');
            searchBar.classList.toggle('hidden');
            searchToggle.setAttribute('aria-expanded', String(isHidden));
            if (isHidden) document.getElementById('searchInput').focus();
        });

        // If a search is already active on page load, show the bar open by default
        <% if (typeof search !== 'undefined' && search) { %>
            searchBar.classList.remove('hidden');
            searchToggle.setAttribute('aria-expanded', 'true');
        <% } %>
    })();
</script>
