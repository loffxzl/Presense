<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Presense</title>

    <!-- BRAND FAVICON -->
    <link rel="icon" type="image/svg+xml" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><rect width='100' height='100' rx='25' fill='%231A1A1A'/><text x='50%' y='68%' font-family='Georgia, serif' font-size='55' font-weight='bold' fill='%23D4AF37' text-anchor='middle'>P</text></svg>">

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        scentCream: '#FDFBF7',
                        scentAmber: '#D4AF37',
                        scentCharcoal: '#1A1A1A',
                        scentEarth: '#705335'
                    }
                }
            }
        }
    </script>
    <style>
        /* Vial indicator — signature element carried over from the product card language.
           Fill height maps to real perfume-oil concentration ranges:
           EDT ~5-15%, EDP ~15-20%, Extrait/Parfum ~20-40%. */
        .vial {
            width: 5px;
            height: 18px;
            border: 1px solid #1A1A1A;
            border-radius: 2px;
            position: relative;
            overflow: hidden;
            flex-shrink: 0;
            background: rgba(26,26,26,0.04);
        }
        .vial-fill {
            position: absolute;
            bottom: 0; left: 0; right: 0;
            background: #D4AF37;
        }

        @media (prefers-reduced-motion: reduce) {
            * { animation-duration: 0.01ms !important; animation-iteration-count: 1 !important; transition-duration: 0.01ms !important; }
        }
    </style>
</head>
<body class="bg-scentCream text-scentCharcoal font-sans antialiased">

    <!-- NAVIGATION BAR -->
    <%- include('../partials/userNavbar', { search, categoryId, sortby, minPrice, maxPrice }) %>

    <!-- Page intro strip -->
    <header class="relative bg-stone-950 px-6 py-10 overflow-hidden">
        <div class="absolute inset-0 bg-[radial-gradient(circle_at_top_left,rgba(212,175,55,0.12)_0%,transparent_60%)] pointer-events-none"></div>
        <div class="max-w-7xl mx-auto relative z-10 flex flex-col md:flex-row md:items-end md:justify-between gap-3">
            <div>
                <span class="text-xs uppercase tracking-widest text-scentAmber font-semibold block mb-2">The Collection</span>
                <h1 class="text-2xl md:text-3xl font-serif text-white tracking-wide"><%= title %></h1>
            </div>
            <span class="font-mono text-xs text-stone-400"><%= totalProducts %> result<%= totalProducts === 1 ? '' : 's' %></span>
        </div>
    </header>

    <div class="max-w-7xl mx-auto px-6 py-14 flex flex-col md:flex-row gap-10">

        <!-- Filters -->
        <aside class="md:w-64 shrink-0">
            <form id="filterForm" action="/products" method="GET" class="space-y-8 bg-white border border-stone-100 rounded-md p-6">
                <input type="hidden" name="search" value="<%= search %>">

                <!-- Sort -->
                <div>
                    <label for="sortby" class="text-xs uppercase tracking-widest text-stone-400 font-semibold block mb-3">Sort by</label>
                    <select id="sortby" name="sortby" onchange="document.getElementById('filterForm').submit()"
                            class="w-full px-3 py-2.5 rounded-sm text-sm border border-stone-200 focus:outline-none focus:border-scentAmber">
                        <% const currentSort = typeof sortby !== 'undefined' ? sortby : 'newest'; %>
                        <option value="newest" <%= currentSort === 'newest' ? 'selected' : '' %>>Newest</option>
                        <option value="lowTohigh" <%= currentSort === 'lowTohigh' ? 'selected' : '' %>>Price: low to high</option>
                        <option value="highTolow" <%= currentSort === 'highTolow' ? 'selected' : '' %>>Price: high to low</option>
                        <option value="a-z" <%= currentSort === 'a-z' ? 'selected' : '' %>>Name: A – Z</option>
                        <option value="z-a" <%= currentSort === 'z-a' ? 'selected' : '' %>>Name: Z – A</option>
                    </select>
                </div>

                <!-- Category -->
                <div class="border-t border-stone-100 pt-6">
                    <p class="text-xs uppercase tracking-widest text-stone-400 font-semibold mb-3">Category</p>
                    <div class="space-y-2.5">
                        <label class="flex items-center gap-2 text-sm cursor-pointer text-scentCharcoal">
                            <input type="radio" name="categoryId" value="" class="accent-scentAmber"
                                   onchange="document.getElementById('filterForm').submit()"
                                   <%= !categoryId ? 'checked' : '' %>>
                            All fragrances
                        </label>
                        <% categories.forEach((cat) => { %>
                            <label class="flex items-center gap-2 text-sm cursor-pointer text-scentCharcoal">
                                <input type="radio" name="categoryId" value="<%= cat._id %>" class="accent-scentAmber"
                                       onchange="document.getElementById('filterForm').submit()"
                                       <%= categoryId === String(cat._id) ? 'checked' : '' %>>
                                <%= cat.name %>
                            </label>
                        <% }) %>
                    </div>
                </div>

                <!-- Price range -->
                <div class="border-t border-stone-100 pt-6">
                    <p class="text-xs uppercase tracking-widest text-stone-400 font-semibold mb-3">Price range</p>
                    <div class="flex items-center gap-2">
                        <label for="minPrice" class="sr-only">Minimum price</label>
                        <input id="minPrice" type="number" name="minPrice" min="0" placeholder="Min"
                               value="<%= typeof minPrice !== 'undefined' ? minPrice : '' %>"
                               class="w-full px-3 py-2.5 rounded-sm text-sm border border-stone-200 focus:outline-none focus:border-scentAmber">
                        <span class="text-stone-400">–</span>
                        <label for="maxPrice" class="sr-only">Maximum price</label>
                        <input id="maxPrice" type="number" name="maxPrice" min="0" placeholder="Max"
                               value="<%= typeof maxPrice !== 'undefined' ? maxPrice : '' %>"
                               class="w-full px-3 py-2.5 rounded-sm text-sm border border-stone-200 focus:outline-none focus:border-scentAmber">
                    </div>
                    <button type="submit" class="w-full mt-4 py-2.5 rounded-sm text-xs font-semibold uppercase tracking-widest bg-scentCharcoal text-white hover:bg-scentAmber hover:text-scentCharcoal transition-colors duration-300">
                        Apply
                    </button>
                </div>

                <% if (categoryId || minPrice || maxPrice || search) { %>
                    <a href="/products" class="block text-center text-xs uppercase tracking-widest text-scentEarth hover:text-scentAmber transition-colors duration-300 pt-2">
                        Clear all filters
                    </a>
                <% } %>
            </form>
        </aside>

        <!-- Product grid -->
        <main class="flex-1">
            <% if (products.length === 0) { %>
                <div class="border border-stone-100 rounded-md py-24 text-center bg-white">
                    <p class="font-serif text-xl mb-2">Nothing matches — yet</p>
                    <p class="text-sm text-stone-500">Try a broader search or clear a filter.</p>
                </div>
            <% } else { %>
                <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-8">
                    <% products.forEach((product) => {
                        const variants = product.varients || [];
                        const prices = variants.map(v => v.salePrice).filter(p => typeof p === 'number');
                        const lowestPrice = prices.length ? Math.min(...prices) : null;
                        const hasActiveOffer = (product.offer || []).some(o => o.isActive && new Date(o.expiryDate) > new Date());
                        const vialFill = product.concentration === 'Extrait de Parfum' ? 100
                                        : product.concentration === 'Eau de Parfum' ? 62
                                        : product.concentration === 'Eau de Toilette' ? 30
                                        : 15; // unknown/unlisted concentration
                    %>
                        <a href="/products/<%= product.slug %>" class="group flex flex-col transform transition-transform duration-300 hover:-translate-y-1">
                            <div class="bg-stone-50 rounded-md p-6 h-72 flex items-center justify-center relative overflow-hidden mb-4 border border-stone-100 transition-all duration-300 group-hover:bg-stone-100/50 group-hover:shadow-md">
                                <% if (product.brand) { %>
                                    <span class="absolute top-3 left-3 bg-stone-900 text-white text-[10px] uppercase font-semibold px-2 py-0.5 tracking-wider rounded z-10 shadow-sm"><%= product.brand %></span>
                                <% } %>
                                <% if (hasActiveOffer) { %>
                                    <span class="absolute top-3 right-3 bg-scentAmber text-scentCharcoal text-[10px] uppercase font-semibold px-2 py-0.5 tracking-wider rounded z-10 shadow-sm">Offer</span>
                                <% } %>
                                <% if (product.image && product.image[0]) { %>
                                    <img src="<%= product.image[0] %>" alt="<%= product.name %>"
                                         class="max-h-44 object-contain transform transition-transform duration-700 ease-out group-hover:scale-105">
                                <% } else { %>
                                    <div class="text-xs text-stone-400">No image</div>
                                <% } %>
                            </div>

                            <span class="text-xs text-stone-400 uppercase tracking-wider mb-1"><%= product.brand %></span>
                            <h3 class="font-medium text-stone-800 group-hover:text-scentAmber transition-colors duration-300 mb-2 truncate"><%= product.name %></h3>

                            <div class="flex items-center gap-2 mb-3">
                                <div class="vial"><div class="vial-fill" style="height:<%= vialFill %>%;"></div></div>
                                <span class="text-xs text-stone-400"><%= product.concentration || 'Concentration unlisted' %></span>
                            </div>

                            <div class="flex items-center justify-between mt-auto pt-3 border-t border-stone-100">
                                <% if (lowestPrice !== null) { %>
                                    <span class="text-sm font-semibold text-stone-900">$<%= lowestPrice.toLocaleString('en-IN') %></span>
                                <% } else { %>
                                    <span class="text-xs text-stone-400">Unavailable</span>
                                <% } %>
                                <% if (product.rating && product.rating.count > 0) { %>
                                    <span class="font-mono text-xs text-stone-400">★ <%= product.rating.average.toFixed(1) %></span>
                                <% } %>
                            </div>
                        </a>
                    <% }) %>
                </div>
            <% } %>

            <!-- Pagination -->
            <% if (totalPages > 1) { %>
                <%
                    const qp = (p) => `page=${p}&search=${encodeURIComponent(search || '')}&categoryId=${encodeURIComponent(categoryId || '')}&sortby=${encodeURIComponent(typeof sortby !== 'undefined' ? sortby : 'newest')}&minPrice=${minPrice || ''}&maxPrice=${maxPrice || ''}`;

                    // Windowed pagination: first, last, current-1..current+1, with '...' for gaps.
                    const pageTokens = [];
                    for (let i = 1; i <= totalPages; i++) {
                        if (i === 1 || i === totalPages || Math.abs(i - currentPage) <= 1) {
                            pageTokens.push(i);
                        } else if (pageTokens[pageTokens.length - 1] !== '...') {
                            pageTokens.push('...');
                        }
                    }
                %>
                <nav aria-label="Pagination" class="flex items-center justify-center gap-2 mt-14">
                    <% if (currentPage > 1) { %>
                        <a href="/products?<%= qp(currentPage - 1) %>" aria-label="Previous page"
                           class="px-3 py-1.5 rounded-sm text-sm border border-stone-200 hover:border-scentAmber transition-colors duration-300">&lt;</a>
                    <% } %>
                    <% pageTokens.forEach((token) => { %>
                        <% if (token === '...') { %>
                            <span class="px-2 text-sm text-stone-400">…</span>
                        <% } else { %>
                            <a href="/products?<%= qp(token) %>"
                               <%= token === currentPage ? 'aria-current="page"' : '' %>
                               class="px-3 py-1.5 rounded-sm text-sm transition-colors duration-300 <%= token === currentPage ? 'bg-scentCharcoal text-white' : 'border border-stone-200 hover:border-scentAmber' %>">
                                <%= token %>
                            </a>
                        <% } %>
                    <% }) %>
                    <% if (currentPage < totalPages) { %>
                        <a href="/products?<%= qp(currentPage + 1) %>" aria-label="Next page"
                           class="px-3 py-1.5 rounded-sm text-sm border border-stone-200 hover:border-scentAmber transition-colors duration-300">&gt;</a>
                    <% } %>
                </nav>
            <% } %>
        </main>
    </div>

    <!-- Footer (matches homepage) -->
    <footer class="bg-scentCharcoal text-stone-400 py-12 px-6 text-center text-sm">
        <p>&copy; 2026 Presense E-Commerce. Built with Node.js, Express, & MongoDB.</p>
    </footer>

</body>
</html>
