<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %> | Presense Admin</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <style>
        .font-serif { font-family: Georgia, Cambria, "Times New Roman", Times, serif; }
    </style>
</head>
<body class="bg-gray-50 flex min-h-screen">

    <%- include('../partials/adminSidebar', { adminName, activePage: 'orders' }) %>

    <main class="flex-1 ml-64 p-8 max-w-4xl">

        <a href="/admin/orders" class="text-sm text-gray-500 hover:text-gray-900 transition">&larr; Back to orders</a>

        <div class="flex items-start justify-between mt-3 mb-6">
            <div>
                <h2 class="text-2xl font-bold"><%= order.orderCode %></h2>
                <p class="text-gray-400 text-sm mt-1">
                    Placed <%= new Date(order.createdAt).toLocaleDateString('en-IN', { year: 'numeric', month: 'long', day: 'numeric' }) %>
                </p>
            </div>
            <span class="inline-flex items-center gap-1.5 text-sm font-medium px-3 py-1.5 rounded-full bg-gray-100 text-gray-700">
                <span class="w-2 h-2 rounded-full
                    <%= order.status === 'delivered' || order.status === 'refunded' ? 'bg-green-500'
                        : order.status === 'cancelled' || order.status === 'return_rejected' ? 'bg-red-400'
                        : order.status.startsWith('return') ? 'bg-amber-500'
                        : 'bg-gray-400' %>"></span>
                <%= statusLabels[order.status] %>
            </span>
        </div>

        <!-- Status control -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
            <h3 class="font-serif text-base font-bold text-gray-900 mb-1">Order Status</h3>
            <p class="text-xs text-gray-400 mb-4">
                Status can only move forward — once an order passes a stage it can never be set back to it.
            </p>

            <% if (order.status === 'return_requested') { %>
                <!-- Return request branches: approve or reject, not a plain forward step -->
                <div class="bg-amber-50 border border-amber-200 rounded-lg p-4">
                    <p class="text-sm text-gray-800 font-medium mb-1">Customer requested a return</p>
                    <% if (order.returnReason) { %>
                        <p class="text-sm text-gray-600 mb-4">"<%= order.returnReason %>"</p>
                    <% } %>

                    <div class="flex gap-3">
                        <button onclick="setStatus('return_approved')"
                                class="bg-gray-900 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-yellow-600 transition">
                            Approve Return
                        </button>
                        <button onclick="openRejectForm()"
                                class="border border-gray-200 text-gray-600 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-gray-50 transition">
                            Reject Return
                        </button>
                    </div>

                    <div id="rejectForm" class="hidden mt-4">
                        <label class="block text-xs font-semibold text-gray-600 uppercase mb-2">Rejection reason</label>
                        <textarea id="rejectionReason" rows="2"
                                  class="w-full px-3 py-2 bg-white border border-gray-200 rounded-lg text-sm focus:outline-none"
                                  placeholder="Explain why this return is being rejected..."></textarea>
                        <button onclick="submitRejection()"
                                class="mt-2 bg-red-600 text-white px-4 py-2 rounded-lg text-sm font-semibold hover:bg-red-700 transition">
                            Confirm Rejection
                        </button>
                    </div>
                </div>

            <% } else if (nextStatuses.length === 1) { %>
                <!-- Exactly one legal next step — a single button, no dropdown needed -->
                <button onclick="setStatus('<%= nextStatuses[0] %>')"
                        class="bg-gray-900 text-white px-5 py-2.5 rounded-lg text-sm font-semibold hover:bg-yellow-600 transition">
                    Mark as <%= statusLabels[nextStatuses[0]] %>
                </button>

            <% } else { %>
                <p class="text-sm text-gray-400">This order has reached a final state — no further action available.</p>
            <% } %>

            <p id="statusError" class="text-red-500 text-xs mt-3 hidden"></p>
        </div>

        <!-- Status timeline -->
        <% if (order.statusHistory && order.statusHistory.length > 0) { %>
            <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
                <h3 class="font-serif text-base font-bold text-gray-900 mb-4">Timeline</h3>
                <ol class="space-y-3">
                    <% order.statusHistory.slice().reverse().forEach((entry) => { %>
                        <li class="flex items-start gap-3 text-sm">
                            <span class="w-1.5 h-1.5 rounded-full bg-gray-400 mt-1.5 shrink-0"></span>
                            <div>
                                <p class="text-gray-900 font-medium"><%= statusLabels[entry.status] || entry.status %></p>
                                <p class="text-gray-400 text-xs">
                                    <%= new Date(entry.changedAt).toLocaleString('en-IN') %>
                                    <% if (entry.note) { %> &middot; <%= entry.note %><% } %>
                                </p>
                            </div>
                        </li>
                    <% }) %>
                </ol>
            </div>
        <% } %>

        <!-- Items -->
        <div class="bg-white rounded-xl border border-gray-200 p-5 mb-6">
            <h3 class="font-serif text-base font-bold text-gray-900 mb-4">Items</h3>
            <div class="divide-y divide-gray-100">
                <% order.items.forEach((item) => { %>
                    <div class="py-3 flex items-center gap-4">
                        <div class="w-14 h-14 rounded-md bg-gray-100 overflow-hidden shrink-0">
                            <% if (item.image) { %>
                                <img src="<%= item.image %>" alt="<%= item.name %>" class="w-full h-full object-cover">
                            <% } %>
                        </div>
                        <div class="flex-1 min-w-0">
                            <p class="text-sm font-medium text-gray-900 truncate"><%= item.name %></p>
                            <p class="text-xs text-gray-400"><%= item.brand %> &middot; <%= item.size %> &middot; Qty <%= item.quantity %></p>
                        </div>
                        <span class="text-xs font-medium px-2 py-1 rounded-full
                            <%= item.status === 'active' ? 'bg-green-50 text-green-700'
                                : item.status === 'cancelled' ? 'bg-red-50 text-red-600'
                                : 'bg-amber-50 text-amber-700' %>">
                            <%= item.status %>
                        </span>
                        <p class="text-sm font-semibold text-gray-900 w-20 text-right">&#8377;<%= item.lineTotal.toFixed(2) %></p>
                    </div>
                <% }) %>
            </div>
        </div>

        <div class="grid grid-cols-2 gap-6">
            <!-- Shipping address -->
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h3 class="font-serif text-base font-bold text-gray-900 mb-3">Shipping Address</h3>
                <p class="text-sm text-gray-700"><%= order.shippingAddress.fullName %></p>
                <p class="text-sm text-gray-500"><%= order.shippingAddress.phone %></p>
                <p class="text-sm text-gray-500 mt-2">
                    <%= order.shippingAddress.line1 %><% if (order.shippingAddress.line2) { %>, <%= order.shippingAddress.line2 %><% } %><br>
                    <%= order.shippingAddress.city %>, <%= order.shippingAddress.state %> <%= order.shippingAddress.pincode %><br>
                    <%= order.shippingAddress.country %>
                </p>
            </div>

            <!-- Pricing -->
            <div class="bg-white rounded-xl border border-gray-200 p-5">
                <h3 class="font-serif text-base font-bold text-gray-900 mb-3">Pricing</h3>
                <div class="space-y-1.5 text-sm">
                    <div class="flex justify-between text-gray-600">
                        <span>Subtotal</span><span>&#8377;<%= order.pricing.subtotal.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Tax</span><span>&#8377;<%= order.pricing.tax.toFixed(2) %></span>
                    </div>
                    <div class="flex justify-between text-gray-600">
                        <span>Shipping</span><span>&#8377;<%= order.pricing.shippingFee.toFixed(2) %></span>
                    </div>
                    <% if (order.pricing.discount > 0) { %>
                        <div class="flex justify-between text-green-600">
                            <span>Discount <% if (order.couponCode) { %>(<%= order.couponCode %>)<% } %></span>
                            <span>-&#8377;<%= order.pricing.discount.toFixed(2) %></span>
                        </div>
                    <% } %>
                    <div class="flex justify-between font-semibold text-gray-900 pt-2 mt-2 border-t border-gray-100">
                        <span>Total</span><span>&#8377;<%= order.pricing.total.toFixed(2) %></span>
                    </div>
                </div>
            </div>
        </div>

    </main>

    <script>
        const orderId = '<%= order._id %>';

        async function sendStatusUpdate(status, reason = '') {
            const errorEl = document.getElementById('statusError');
            errorEl.classList.add('hidden');

            try {
                const res = await fetch(`/admin/orders/${orderId}/status`, {
                    method: 'PATCH',
                    headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
                    credentials: 'same-origin',
                    body: JSON.stringify({ status, reason })
                });

                const result = await res.json();
                if (!res.ok) throw new Error(result.message || 'Could not update status');

                window.location.reload();
            } catch (err) {
                errorEl.textContent = err.message;
                errorEl.classList.remove('hidden');
            }
        }

        function setStatus(status) {
            sendStatusUpdate(status);
        }

        function openRejectForm() {
            document.getElementById('rejectForm').classList.remove('hidden');
        }

        function submitRejection() {
            const reason = document.getElementById('rejectionReason').value.trim();
            if (!reason) {
                alert('Please provide a rejection reason.');
                return;
            }
            sendStatusUpdate('return_rejected', reason);
        }
    </script>

</body>
</html>
