<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title %> | Presense</title>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:ital,opsz,wght@0,9..144,300;0,9..144,500;0,9..144,600;1,9..144,400;1,9..144,500&family=Work+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap" rel="stylesheet">

<style>
    :root{
        --bg:#E4E0D4;
        --ink:#18160F;
        --ink-soft:#5A5647;
        --card:#F7F5EE;
        --line:#C7C0AC;
        --accent:#7A2E22;
        --sale:#4B5A3D;
    }
    *{ box-sizing:border-box; }
    body{ margin:0; background:var(--bg); color:var(--ink); font-family:'Work Sans', sans-serif; -webkit-font-smoothing:antialiased; }
    a{ color:inherit; text-decoration:none; }

    header{
        display:flex; align-items:center; justify-content:space-between;
        padding:22px 48px; border-bottom:1px solid var(--line);
    }
    .wordmark{ font-family:'Fraunces', serif; font-size:22px; font-weight:600; }
    .header-links{ display:flex; gap:28px; font-size:13px; }
    .header-links a{ opacity:0.75; } .header-links a:hover{ opacity:1; }

    main{ padding:48px; max-width:920px; margin:0 auto; }
    h1{ font-family:'Fraunces', serif; font-style:italic; font-weight:400; font-size:32px; margin:0 0 32px; }

    .empty{
        border:1px solid var(--line); background:var(--card);
        padding:80px 24px; text-align:center;
    }
    .empty h3{ font-family:'Fraunces', serif; font-style:italic; font-weight:400; font-size:24px; margin:0 0 8px; }
    .empty p{ color:var(--ink-soft); font-size:14px; margin:0 0 20px; }
    .empty a{
        display:inline-block; font-family:'IBM Plex Mono', monospace; font-size:11px;
        text-transform:uppercase; letter-spacing:0.08em; padding:10px 20px;
        border:1px solid var(--ink); border-radius:6px;
    }

    .cart-item{
        display:grid;
        grid-template-columns:88px 1fr auto auto;
        gap:18px;
        align-items:center;
        padding:20px 0;
        border-bottom:1px solid var(--line);
    }
    .cart-item img{ width:88px; height:88px; object-fit:cover; border-radius:6px; background:#DEDACC; }
    .no-image-sm{
        width:88px; height:88px; border-radius:6px; background:#DEDACC;
        display:flex; align-items:center; justify-content:center;
        font-family:'IBM Plex Mono', monospace; font-size:9px; color:var(--ink-soft);
        text-transform:uppercase; letter-spacing:0.06em; text-align:center;
    }

    .item-brand{ font-family:'IBM Plex Mono', monospace; font-size:10px; letter-spacing:0.08em; text-transform:uppercase; color:var(--ink-soft); }
    .item-name{ font-family:'Fraunces', serif; font-size:18px; font-weight:500; margin:2px 0; }
    .item-size{ font-size:12px; color:var(--ink-soft); }
    .item-warning{ font-size:12px; color:var(--accent); margin-top:4px; }

    .qty-control{ display:flex; align-items:center; border:1px solid var(--line); border-radius:6px; }
    .qty-control button{
        width:30px; height:30px; border:none; background:transparent; cursor:pointer;
        font-family:'IBM Plex Mono', monospace; font-size:14px; color:var(--ink);
    }
    .qty-control button:disabled{ opacity:0.3; cursor:not-allowed; }
    .qty-control span{ width:28px; text-align:center; font-family:'IBM Plex Mono', monospace; font-size:13px; }

    .item-side{ display:flex; flex-direction:column; align-items:flex-end; gap:8px; }
    .line-price{ font-family:'IBM Plex Mono', monospace; font-size:14px; }
    .remove-btn{
        font-family:'IBM Plex Mono', monospace; font-size:10px; text-transform:uppercase;
        letter-spacing:0.06em; color:var(--ink-soft); background:none; border:none; cursor:pointer;
        border-bottom:1px solid var(--line);
    }
    .remove-btn:hover{ color:var(--accent); border-color:var(--accent); }

    .summary{
        margin-top:32px; padding-top:20px; border-top:1px solid var(--ink);
        display:flex; justify-content:space-between; align-items:baseline;
    }
    .summary .label{ font-family:'IBM Plex Mono', monospace; font-size:12px; text-transform:uppercase; letter-spacing:0.08em; color:var(--ink-soft); }
    .summary .amount{ font-family:'Fraunces', serif; font-size:26px; }

    .checkout-note{ font-size:12px; color:var(--accent); margin-top:10px; text-align:right; }

    .checkout-btn{
        margin-top:24px; width:100%; padding:16px;
        font-family:'IBM Plex Mono', monospace; font-size:12px; text-transform:uppercase; letter-spacing:0.08em;
        background:var(--ink); color:var(--card); border:none; border-radius:6px; cursor:pointer;
    }
    .checkout-btn:disabled{ opacity:0.5; cursor:not-allowed; }

    @media (max-width:600px){
        header, main{ padding-left:20px; padding-right:20px; }
        .header-links{ display:none; }
        .cart-item{ grid-template-columns:64px 1fr; grid-template-rows:auto auto; }
        .cart-item img, .no-image-sm{ width:64px; height:64px; }
        .item-side{ grid-column:2; flex-direction:row; justify-content:space-between; align-items:center; }
        .qty-control{ grid-column:2; }
    }
</style>
</head>
<body>

<header>
    <a href="/" class="wordmark">Presense</a>
    <nav class="header-links">
        <a href="/products">Fragrances</a>
        <a href="/about">Story</a>
        <a href="/account">Account</a>
        <a href="/cart">Bag</a>
    </nav>
</header>

<main>
    <h1>Your bag</h1>

    <%
        const currency = (n) => '₹' + Number(n).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
        const hasBlockingIssue = items.some((i) => i.unavailable || i.quantity > i.stock);
    %>

    <div id="cartRoot">
        <% if (items.length === 0) { %>
            <div class="empty">
                <h3>Your bag is empty.</h3>
                <p>Whatever you're drawn to is still waiting on the shelf.</p>
                <a href="/products">Browse fragrances</a>
            </div>
        <% } else { %>
            <div id="itemsList">
                <% items.forEach((item) => { %>
                    <div class="cart-item" data-product-id="<%= item.productId %>" data-variant-id="<%= item.variantId %>" data-stock="<%= item.stock %>">
                        <% if (item.image) { %>
                            <img src="<%= item.image %>" alt="<%= item.name %>">
                        <% } else { %>
                            <div class="no-image-sm">No image</div>
                        <% } %>

                        <div>
                            <div class="item-brand"><%= item.brand %></div>
                            <div class="item-name"><%= item.name %></div>
                            <div class="item-size"><%= item.size %></div>
                            <% if (item.unavailable) { %>
                                <div class="item-warning">This size is no longer available</div>
                            <% } else if (item.quantity > item.stock) { %>
                                <div class="item-warning">Only <%= item.stock %> left in stock</div>
                            <% } %>
                        </div>

                        <div class="qty-control">
                            <button type="button" class="qty-minus" aria-label="Decrease quantity" <%= item.quantity <= 1 ? 'disabled' : '' %>>–</button>
                            <span class="qty-value"><%= item.quantity %></span>
                            <button type="button" class="qty-plus" aria-label="Increase quantity" <%= (item.unavailable || item.quantity >= item.stock) ? 'disabled' : '' %>>+</button>
                        </div>

                        <div class="item-side">
                            <span class="line-price"><%= currency(item.lineTotal) %></span>
                            <button type="button" class="remove-btn">Remove</button>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="summary">
                <span class="label">Subtotal</span>
                <span class="amount" id="subtotalAmount"><%= currency(subtotal) %></span>
            </div>

            <% if (hasBlockingIssue) { %>
                <p class="checkout-note">Resolve unavailable or out-of-stock items before checking out.</p>
            <% } %>

            <button type="button" class="checkout-btn" id="checkoutBtn" <%= hasBlockingIssue ? 'disabled' : '' %>>
                Proceed to checkout
            </button>
        <% } %>
    </div>
</main>

<script>
    const itemsList = document.getElementById('itemsList');

    async function callCartApi(url, method, body) {
        const response = await fetch(url, {
            method,
            headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
            credentials: 'same-origin',
            body: body ? JSON.stringify(body) : undefined
        });
        const result = await response.json();
        if (!response.ok) throw new Error(result.message || 'Something went wrong');
        return result;
    }

    function renderAfterUpdate(data) {
        // Simplest reliable approach: reload so quantities/stock warnings/subtotal
        // all stay perfectly in sync with the server.
        window.location.reload();
    }

    if (itemsList) {
        itemsList.addEventListener('click', async (e) => {
            if (e.target.disabled) return; // respect the disabled state rendered server-side

            const row = e.target.closest('.cart-item');
            if (!row) return;
            const productId = row.dataset.productId;
            const variantId = row.dataset.variantId;
            const stock = Number(row.dataset.stock);
            const qtyEl = row.querySelector('.qty-value');
            const currentQty = Number(qtyEl.textContent);

            try {
                if (e.target.classList.contains('qty-plus')) {
                    if (currentQty + 1 > stock) return alert('No more stock available for this size.');
                    const data = await callCartApi(`/cart/${productId}/${variantId}`, 'PATCH', { quantity: currentQty + 1 });
                    renderAfterUpdate(data);
                }
                if (e.target.classList.contains('qty-minus')) {
                    if (currentQty <= 1) return; // use Remove to drop to zero
                    const data = await callCartApi(`/cart/${productId}/${variantId}`, 'PATCH', { quantity: currentQty - 1 });
                    renderAfterUpdate(data);
                }
                if (e.target.classList.contains('remove-btn')) {
                    const data = await callCartApi(`/cart/${productId}/${variantId}`, 'DELETE');
                    renderAfterUpdate(data);
                }
            } catch (err) {
                alert(err.message);
            }
        });
    }

    const checkoutBtn = document.getElementById('checkoutBtn');
    if (checkoutBtn) {
        checkoutBtn.addEventListener('click', () => {
            if (checkoutBtn.disabled) return;
            window.location.href = '/checkout';
        });
    }
</script>

</body>
</html>
